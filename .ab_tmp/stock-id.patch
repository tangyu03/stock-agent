 def stock_identity(data) -> str:
     """独立推送的稳定首行标识：标的名称(代码)。"""
     name = str((data or {}).get("stock_name") or "").strip() or "未知标的"
     code = str((data or {}).get("stock_code") or "").strip() or "未知代码"
     return f"{name}({code})"
+
+
+def _stock_id_text(data) -> str:
+    """跨层级串联ID：卡片段只展示末8位，降低长ID的阅读噪音。"""
+    event_id = str((data or {}).get("event_id") or "").strip()
+    if not event_id:
+        plan = (data or {}).get("execution_plan") or {}
+        event_id = str(plan.get("event_id") or "").strip()
+    return f" #{event_id[-8:]}" if event_id else ""
